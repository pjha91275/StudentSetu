# Database Connection
# For Local Development with SQLite (zero external setup):
DATABASE_URL="file:./dev.db"

# Or configure Cloud PostgreSQL (e.g. Supabase / Neon / RDS):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB]?sslmode=require"
# DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB]?sslmode=require"

NODE_ENV="development"
